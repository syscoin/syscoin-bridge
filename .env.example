# Frontend/API routing
NEXT_PUBLIC_API_BASE_URL=
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Network
NEXT_PUBLIC_IS_TESTNET=true
IS_TESTNET=true
NEXT_PUBLIC_CHAIN_ID=0x1644
CHAIN_ID=0x1644
NEVM_RPC_URL=https://rpc.example.org
UTXO_RPC_URL=https://blockbook.example.org
NEVM_EXPLORER=https://explorer.example.org
UTXO_EXPLORER=https://blockbook.example.org
NEXT_PUBLIC_BLOCKBOOK_API_URL=https://blockbook.example.org
RELAY_CONTRACT_ADDRESS=
ERC20_MANAGER_CONTRACT_ADDRESS=

# Bridge features
MINIMUM_AMOUNT=100
PALI_V2_NEVM_ENABLED=true
SYS5_ENABLED=true
FOUNDATION_FUNDED=false
NEVM_V2_ACTIVATION_BLOCK=

# Database and admin authentication
MONGO_ROOT_USER=replace-me
MONGO_ROOT_PASSWORD=replace-me
MONGO_APP_DB=bridge
MONGODB_URI=mongodb://replace-me:replace-me@db:27017/bridge?authSource=admin
SECRET_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-a-random-secret
ADMIN_COOKIE_DOMAIN=

# Optional foundation sponsor wallets; configure only on the backend
NEVM_SPONSOR_PRIVATE_KEY=
UTXO_SPONSOR_ADDRESS=
UTXO_SPONSOR_WIF=
UTXO_SPONSOR_CLAIM_GAS_AMOUNT_SYS=0.001
SPONSOR_IP_RATE_LIMIT=20
SPONSOR_ADDRESS_RATE_LIMIT=3
SPONSOR_RATE_LIMIT_WINDOW_MS=86400000
SPONSOR_TRUST_PROXY_HEADERS=false

# Hetzner Compose host bindings
BRIDGE_HOST_PORT=3000
MONGO_HOST_PORT=37019
MONGO_BACKUP_VOLUME=syscoin-bridge-mainnet_mongo-backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Optional Syscoin-owned Sentry project
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
